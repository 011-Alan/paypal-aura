      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Demo Login (Alex Sharma)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Returns JWT token and sanitized user profile', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.token).to.be.a('string');",
                  "  pm.expect(json.user.passwordHash).to.be.undefined;",
                  "  pm.expect(json.user.pinHash).to.be.undefined;",
                  "});",
                  "if (json.token) { pm.environment.set('authToken', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/demo-login"
          }
        },
        {
          "name": "1.2 Verify Authenticated Session (/auth/me)",
