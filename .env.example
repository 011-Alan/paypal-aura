# ============================================================================
# PROJECT AURA — Environment Configuration Template (.env.example)
# Copy this file to server/.env and client/.env as needed.
# NEVER commit actual secrets, API keys, or credentials to version control.
# ============================================================================

# --- 1. Server & Application Runtime (Render) ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000/api
ENABLE_BACKGROUND_WORKERS=true

# --- 2. Primary Transactional Database (MongoDB Atlas / Local) ---
# If omitted or unreachable in development, AURA automatically starts a local
# embedded MongoDB instance via mongodb-memory-server with persistent JSON snapshots.
MONGODB_URI=mongodb://127.0.0.1:27017/aura_fintech

# --- 3. Security & Authentication ---
JWT_SECRET=replace-with-secure-64-char-random-secret-in-production
JWT_EXPIRES_IN=24h
APPROVAL_TOKEN_SECRET=replace-with-secure-approval-token-secret
APPROVAL_TOKEN_TTL_SECONDS=300
CSRF_SECRET=replace-with-csrf-protection-secret

# --- 4. Google Gemini AI Multi-Model Architecture ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_LIGHTWEIGHT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_MODEL=gemini-3.8-flash

# Per-Model Application Rate Limits (Conservative Safety Targets)
GEMINI_PRIMARY_RPM_LIMIT=3
GEMINI_LIGHTWEIGHT_RPM_LIMIT=10
GEMINI_EMBEDDING_RPM_LIMIT=80
GEMINI_RPM_LIMIT=3

GEMINI_QUEUE_TIMEOUT_MS=45000
GEMINI_MAX_HISTORY_TURNS=6
GEMINI_ENABLE_SAFE_CACHE=true

# --- 5. PayPal Official Integration (Identity & Orders API v2 Execution Layer) ---
# Environment switch: 'sandbox' or 'live'
PAYPAL_MODE=sandbox
PAYPAL_ENVIRONMENT=sandbox
# Base URLs: automatically set based on PAYPAL_MODE if left blank:
# Sandbox API: https://api-m.sandbox.paypal.com | Sandbox Web: https://www.sandbox.paypal.com
# Live API: https://api-m.paypal.com | Live Web: https://www.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEB_URL=https://www.sandbox.paypal.com

# PayPal Orders API v2 & Identity API Credentials
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_IDENTITY_CLIENT_ID=your_paypal_identity_client_id_here
PAYPAL_IDENTITY_CLIENT_SECRET=your_paypal_identity_client_secret_here

# Redirect and return endpoints
PAYPAL_IDENTITY_REDIRECT_URI=http://localhost:4000/api/auth/paypal/callback
PAYPAL_RETURN_URL=http://localhost:5173/payments?status=approved
PAYPAL_CANCEL_URL=http://localhost:5173/payments?status=cancelled

# Webhook configuration
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_DEFAULT_CURRENCY=USD
# Display currency conversion rate (1 USD = ~84 INR for Indian Rupee display alongside PayPal USD settlement)
INR_TO_USD_RATE=0.01190476

# --- 6. Sponsor 1: AG Grid / AG Studio ---
AG_GRID_LICENSE_KEY=
AG_STUDIO_ENABLED=false

# --- 7. Sponsor 2: APIMatic (PayPal API Development Context & Contract Validation) ---
APIMATIC_STRICT_CONTRACT_VALIDATION=true
APIMATIC_PAYPAL_SPEC_VERSION=2.1.0

# --- 8. Sponsor 3: Astropods (Official Remote Multi-Agent Deployment & Orchestration) ---
ASTROPODS_API_URL=https://astropods.com/api/v1
ASTROPODS_ACCOUNT=
ASTROPODS_ACCESS_TOKEN=
ASTROPODS_API_KEY=
ASTROPODS_WORKSPACE_ID=aura-financial-agents
ASTROPODS_TIMEOUT_MS=15000
ASTROPODS_MAX_RETRIES=2
# Cloud Deployment IDs (populated by `ast deploy <blueprint> --adapter web --wait --json`)
ASTROPODS_DEPLOYMENT_FINANCIAL_PLANNER=
ASTROPODS_DEPLOYMENT_TRANSACTION_INTELLIGENCE=
ASTROPODS_DEPLOYMENT_MANDATE_INTELLIGENCE=
ASTROPODS_DEPLOYMENT_FINANCIAL_RECOVERY=
ASTROPODS_DEPLOYMENT_PURCHASE_INTELLIGENCE=
ASTROPODS_DEPLOYMENT_FINANCIAL_GUARDIAN=
# Optional Direct Web Adapter URLs (e.g. http://localhost:3101..3106 or https://<pod>.astropods.com)
ASTROPODS_URL_FINANCIAL_PLANNER=
ASTROPODS_URL_TRANSACTION_INTELLIGENCE=
ASTROPODS_URL_MANDATE_INTELLIGENCE=
ASTROPODS_URL_FINANCIAL_RECOVERY=
ASTROPODS_URL_PURCHASE_INTELLIGENCE=
ASTROPODS_URL_FINANCIAL_GUARDIAN=

# --- 9. Sponsor 4: Bryntum (Financial Life Calendar) ---
BRYNTUM_CALENDAR_ENABLED=true
BRYNTUM_DEFAULT_VIEW=month

# --- 10. Sponsor 5: Channel3 (Smart Purchase Companion & Product Discovery) ---
CHANNEL3_API_URL=https://api.trychannel3.com/v1
CHANNEL3_API_KEY=

# --- 11. Sponsor 6: Elastic (Financial Memory & Hybrid Search) ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=aura

# --- 12. Sponsor 7: KERNEL (Controlled Browser Automation & Assisted Research) ---
KERNEL_API_URL=https://api.onkernel.com/v1
KERNEL_API_KEY=
KERNEL_MAX_SESSION_SECONDS=60

# --- 13. Sponsor 10: Zapier MCP (External Financial Workflow Automation) ---
ZAPIER_MCP_URL=https://mcp.zapier.com/api/v1
ZAPIER_API_KEY=
ZAPIER_WEBHOOK_URL=

# --- 14. Python Analytics Engine ---
PYTHON_EXECUTABLE=python
